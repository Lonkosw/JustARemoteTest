{
  "name": "treino",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "scripts/test-db.sh",
    "test:sync": "scripts/test-backend/start.sh && SYNC_E2E=1 playwright test; status=$?; scripts/test-backend/stop.sh; exit $status",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run test:e2e && npm run test:sync"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
